<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:microchart="sap.suite.ui.microchart"
>
    <VBox id="idDashboardVBox" renderType="Bare" width="100%">

        <Title id="idControleDeComprasTitle" text="Controle de Compras" level="H2" class="sapUiSmallMargin" />

        <!-- Filtros -->
        <VBox id="idDashboardFiltrosVBox" class="sapUiSmallMargin">
            <Panel id="idDashboardFiltrosPanel" headerText="Filtros">
                <content>
                    <HBox id="idDashboardFiltrosHBox" alignItems="End" wrap="Wrap">
                        <VBox id="idMesReferenciaVBox" width="16rem" class="sapUiSmallMargin">
                            <Label id="idMesReferenciaLabel" text="Mês de Referência" />
                            <Select
                                id="idMesReferenciaSelect"
                                selectedKey="{dashboardData>/filter/period}"
                                width="100%"
                                items="{dashboardData>/monthOptions}"
                            >
                                <core:Item id="idMesReferenciaItem" key="{dashboardData>key}" text="{dashboardData>text}" />
                            </Select>
                        </VBox>

                        <Button
                            id="idDashboardIniciarButton"
                            text="Iniciar"
                            type="Emphasized"
                            press=".onDashboardIniciarButtonPress"
                            class="sapUiSmallMarginBottom sapUiSmallMarginBegin"
                        />
                    </HBox>
                </content>
            </Panel>
        </VBox>

        <!-- 4 KPI cards -->
        <HBox id="idKpiHBox" justifyContent="SpaceBetween" wrap="Wrap" class="sapUiSmallMargin">
            <VBox id="idKpiTotalComprasVBox" width="24%" class="dashboardKpiCard">
                <HBox id="idKpiTotalComprasHBox" alignItems="Center">
                    <core:Icon id="idKpiTotalComprasIcon" src="sap-icon://money-bills" class="dashboardKpiIcon" />
                    <Text id="idKpiTotalComprasLabel" text="Total Geral Compras" class="dashboardKpiLabel" />
                </HBox>
                <Text id="idKpiTotalComprasText" text="{path: 'dashboardData>/kpis/totalBuys', formatter: '.formatCompactCurrency'}" class="dashboardKpiValue" />
            </VBox>
            <VBox id="idKpiTotalPedidosVBox" width="24%" class="dashboardKpiCard">
                <HBox id="idKpiTotalPedidosHBox" alignItems="Center">
                    <core:Icon id="idKpiTotalPedidosIcon" src="sap-icon://sales-order" class="dashboardKpiIcon" />
                    <Text id="idKpiTotalPedidosLabel" text="Total Geral Pedidos" class="dashboardKpiLabel" />
                </HBox>
                <Text id="idKpiTotalPedidosText" text="{path: 'dashboardData>/kpis/totalOrders', formatter: '.formatCompactNumber'}" class="dashboardKpiValue" />
            </VBox>
            <VBox id="idKpiTotalProdutosVBox" width="24%" class="dashboardKpiCard">
                <HBox id="idKpiTotalProdutosHBox" alignItems="Center">
                    <core:Icon id="idKpiTotalProdutosIcon" src="sap-icon://product" class="dashboardKpiIcon" />
                    <Text id="idKpiTotalProdutosLabel" text="Total Geral Produtos" class="dashboardKpiLabel" />
                </HBox>
                <Text id="idKpiTotalProdutosText" text="{path: 'dashboardData>/kpis/totalProducts', formatter: '.formatCompactNumber'}" class="dashboardKpiValue" />
            </VBox>
            <VBox id="idKpiMediaTempoVBox" width="24%" class="dashboardKpiCard">
                <HBox id="idKpiMediaTempoHBox" alignItems="Center">
                    <core:Icon id="idKpiMediaTempoIcon" src="sap-icon://history" class="dashboardKpiIcon" />
                    <Text id="idKpiMediaTempoLabel" text="Média Tempo Geral Atendimento" class="dashboardKpiLabel" />
                </HBox>
                <Text id="idKpiMediaTempoText" text="{path: 'dashboardData>/kpis/averageLeadTime', formatter: '.formatMinutes'}" class="dashboardKpiValue" />
            </VBox>
        </HBox>

        <!-- Linha 1: Andamento dos pedidos + Comparativo 2 produtos -->
        <HBox id="idChartsRow1HBox" justifyContent="SpaceBetween" wrap="Wrap" class="sapUiSmallMargin">

            <!-- Andamento dos pedidos: 4 gauges -->
            <VBox id="idAndamentoPedidosVBox" width="48%" height="100%">
                <Panel id="idAndamentoPedidosPanel" headerText="Andamento dos Pedidos" height="100%" class="sapUiSmallMargin">
                    <content>
                        <HBox id="idAndamentoPedidosDonutsHBox" justifyContent="SpaceBetween" wrap="Wrap">

                            <VBox id="idDonutEntregaAntecipadaVBox" width="24%" alignItems="Center">
                                <Text id="idDonutEntregaAntecipadaLabel" text="Entrega Antecipada" textAlign="Center" class="dashboardGaugeLabel" />
                                <Text id="idDonutEntregaAntecipadaPercent" text="{dashboardData>/ordersStatus/earlyPercentage}%" textAlign="Center" class="dashboardGaugePercent" />
                                <VBox id="idDonutEntregaAntecipadaGaugeWrap" class="dashboardGaugeWrap" alignItems="Center">
                                    <microchart:RadialMicroChart
                                        id="idDonutEntregaAntecipadaVizFrame"
                                        percentage="{dashboardData>/ordersStatus/earlyPercentage}"
                                        valueColor="Good"
                                        size="M"
                                    />
                                    <Text id="idDonutEntregaAntecipadaCenterText" text="{dashboardData>/ordersStatus/early}" class="dashboardGaugeCenterText" />
                                </VBox>
                            </VBox>

                            <VBox id="idDonutPendenteVBox" width="24%" alignItems="Center">
                                <Text id="idDonutPendenteLabel" text="Pendente" textAlign="Center" class="dashboardGaugeLabel" />
                                <Text id="idDonutPendentePercent" text="{dashboardData>/ordersStatus/pendingPercentage}%" textAlign="Center" class="dashboardGaugePercent" />
                                <VBox id="idDonutPendenteGaugeWrap" class="dashboardGaugeWrap" alignItems="Center">
                                    <microchart:RadialMicroChart
                                        id="idDonutPendenteVizFrame"
                                        percentage="{dashboardData>/ordersStatus/pendingPercentage}"
                                        valueColor="Critical"
                                        size="M"
                                    />
                                    <Text id="idDonutPendenteCenterText" text="{dashboardData>/ordersStatus/pending}" class="dashboardGaugeCenterText" />
                                </VBox>
                            </VBox>

                            <VBox id="idDonutEntregaNoPrazoVBox" width="24%" alignItems="Center">
                                <Text id="idDonutEntregaNoPrazoLabel" text="Entrega no Prazo" textAlign="Center" class="dashboardGaugeLabel" />
                                <Text id="idDonutEntregaNoPrazoPercent" text="{dashboardData>/ordersStatus/onTimePercentage}%" textAlign="Center" class="dashboardGaugePercent" />
                                <VBox id="idDonutEntregaNoPrazoGaugeWrap" class="dashboardGaugeWrap" alignItems="Center">
                                    <microchart:RadialMicroChart
                                        id="idDonutEntregaNoPrazoVizFrame"
                                        percentage="{dashboardData>/ordersStatus/onTimePercentage}"
                                        valueColor="Good"
                                        size="M"
                                    />
                                    <Text id="idDonutEntregaNoPrazoCenterText" text="{dashboardData>/ordersStatus/onTime}" class="dashboardGaugeCenterText" />
                                </VBox>
                            </VBox>

                            <VBox id="idDonutEntregaForaDoPrazoVBox" width="24%" alignItems="Center">
                                <Text id="idDonutEntregaForaDoPrazoLabel" text="Entrega Fora do Prazo" textAlign="Center" class="dashboardGaugeLabel" />
                                <Text id="idDonutEntregaForaDoPrazoPercent" text="{dashboardData>/ordersStatus/outTimePercentage}%" textAlign="Center" class="dashboardGaugePercent" />
                                <VBox id="idDonutEntregaForaDoPrazoGaugeWrap" class="dashboardGaugeWrap" alignItems="Center">
                                    <microchart:RadialMicroChart
                                        id="idDonutEntregaForaDoPrazoVizFrame"
                                        percentage="{dashboardData>/ordersStatus/outTimePercentage}"
                                        valueColor="Error"
                                        size="M"
                                    />
                                    <Text id="idDonutEntregaForaDoPrazoCenterText" text="{dashboardData>/ordersStatus/outTime}" class="dashboardGaugeCenterText" />
                                </VBox>
                            </VBox>

                        </HBox>
                    </content>
                </Panel>
            </VBox>

            <!-- Comparativo 2 produtos -->
            <VBox id="idComparativoProdutosVBox" width="48%" height="100%">
                <Panel id="idComparativoProdutosPanel" headerText="Comparativo 2 Produtos" height="100%" class="sapUiSmallMargin">
                    <content>
                        <VBox id="idComparativoProdutosContentVBox" renderType="Bare">
                            <HBox id="idComparativoSelectsHBox" justifyContent="SpaceBetween" wrap="NoWrap">
                                <VBox id="idProduto1VBox" width="48%" class="sapUiTinyMargin">
                                    <Label id="idProduto1Label" text="Produto 1" />
                                    <Select
                                        id="idProduto1Select"
                                        width="100%"
                                        selectedKey="{dashboardData>/productCompare/material1}"
                                        items="{dashboardData>/materialOptions}"
                                        change=".onProdutoCompareSelectChange"
                                    >
                                        <core:Item id="idProduto1Item" key="{dashboardData>key}" text="{dashboardData>text}" />
                                    </Select>
                                </VBox>
                                <VBox id="idProduto2VBox" width="48%" class="sapUiTinyMargin">
                                    <Label id="idProduto2Label" text="Produto 2" />
                                    <Select
                                        id="idProduto2Select"
                                        width="100%"
                                        selectedKey="{dashboardData>/productCompare/material2}"
                                        items="{dashboardData>/materialOptions}"
                                        change=".onProdutoCompareSelectChange"
                                    >
                                        <core:Item id="idProduto2Item" key="{dashboardData>key}" text="{dashboardData>text}" />
                                    </Select>
                                </VBox>
                            </HBox>
                            <HBox id="idComparativoGaugesHBox" justifyContent="SpaceAround" class="sapUiSmallMarginTop">
                                <VBox id="idComparativoProduto1VBox" alignItems="Center">
                                    <microchart:RadialMicroChart
                                        id="idComparativoProduto1VizFrame"
                                        percentage="{dashboardData>/productCompare/percentage1}"
                                        valueColor="Neutral"
                                        size="M"
                                    />
                                </VBox>
                                <VBox id="idComparativoProduto2VBox" alignItems="Center">
                                    <microchart:RadialMicroChart
                                        id="idComparativoProduto2VizFrame"
                                        percentage="{dashboardData>/productCompare/percentage2}"
                                        valueColor="Critical"
                                        size="M"
                                    />
                                </VBox>
                            </HBox>
                        </VBox>
                    </content>
                </Panel>
            </VBox>
        </HBox>

        <!-- Linha 2: Total por região + Valor por grupo comprador -->
        <HBox id="idChartsRow2HBox" justifyContent="SpaceBetween" wrap="Wrap" class="sapUiSmallMargin">

            <!-- Total pedido x comprador x região -->
            <VBox id="idTotalPorRegiaoVBox" width="48%">
                <Panel id="idTotalPorRegiaoPanel" headerText="Total Pedido x Comprador x Região" class="sapUiSmallMargin">
                    <content>
                        <viz:VizFrame id="idTotalPorRegiaoVizFrame" vizType="column" width="100%" height="300px" uiConfig="{applicationSet:'fiori'}" vizProperties="{title: {visible: false}, valueAxis: {title: {text: 'Região'}}}">
                            <viz:dataset>
                                <viz.data:FlattenedDataset id="idTotalPorRegiaoDataset" data="{dashboardData>/totalPerRegion/chartData}">
                                    <viz.data:dimensions>
                                        <viz.data:DimensionDefinition id="idTotalPorRegiaoDim" name="Comprador" value="{dashboardData>name}" />
                                    </viz.data:dimensions>
                                    <viz.data:measures>
                                        <viz.data:MeasureDefinition id="idMeasCentroOeste" name="Centro-Oeste" value="{dashboardData>centroOeste}" />
                                        <viz.data:MeasureDefinition id="idMeasNordeste" name="Nordeste" value="{dashboardData>nordeste}" />
                                        <viz.data:MeasureDefinition id="idMeasNorte" name="Norte" value="{dashboardData>norte}" />
                                        <viz.data:MeasureDefinition id="idMeasSudeste" name="Sudeste" value="{dashboardData>sudeste}" />
                                        <viz.data:MeasureDefinition id="idMeasSul" name="Sul" value="{dashboardData>sul}" />
                                    </viz.data:measures>
                                </viz.data:FlattenedDataset>
                            </viz:dataset>
                            <viz:feeds>
                                <viz.feeds:FeedItem id="idTotalPorRegiaoFeedVal" uid="valueAxis" type="Measure" values="Centro-Oeste,Nordeste,Norte,Sudeste,Sul" />
                                <viz.feeds:FeedItem id="idTotalPorRegiaoFeedCat" uid="categoryAxis" type="Dimension" values="Comprador" />
                            </viz:feeds>
                        </viz:VizFrame>
                    </content>
                </Panel>
            </VBox>

            <!-- Valor por grupo comprador (era "status por tipo de despesa" - backend só oferece por grupo comprador) -->
            <VBox id="idStatusPorTipoDespesaVBox" width="48%">
                <Panel id="idStatusPorTipoDespesaPanel" headerText="Valor por Grupo Comprador" class="sapUiSmallMargin">
                    <content>
                        <viz:VizFrame id="idStatusPorTipoDespesaVizFrame" vizType="bar" width="100%" height="300px" uiConfig="{applicationSet:'fiori'}" vizProperties="{title: {visible: false}}">
                            <viz:dataset>
                                <viz.data:FlattenedDataset id="idStatusPorTipoDespesaDataset" data="{dashboardData>/statusPerBuyerGroup/chartData}">
                                    <viz.data:dimensions>
                                        <viz.data:DimensionDefinition id="idStatusPorTipoDespesaDim" name="Grupo" value="{dashboardData>name}" />
                                    </viz.data:dimensions>
                                    <viz.data:measures>
                                        <viz.data:MeasureDefinition id="idStatusPorTipoDespesaMeas" name="Valor" value="{dashboardData>value}" />
                                    </viz.data:measures>
                                </viz.data:FlattenedDataset>
                            </viz:dataset>
                            <viz:feeds>
                                <viz.feeds:FeedItem id="idStatusPorTipoDespesaFeedVal" uid="valueAxis" type="Measure" values="Valor" />
                                <viz.feeds:FeedItem id="idStatusPorTipoDespesaFeedCat" uid="categoryAxis" type="Dimension" values="Grupo" />
                            </viz:feeds>
                        </viz:VizFrame>
                    </content>
                </Panel>
            </VBox>
        </HBox>

    </VBox>
</core:FragmentDefinition>
