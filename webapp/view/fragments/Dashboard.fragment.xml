<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:microchart="sap.suite.ui.microchart"
>
<VBox id="idDashboardFragmentVBox">
    <Breadcrumbs 
        id="idDashboardBreadcrumbs"
    >
    </Breadcrumbs>

    <Title id="idDashboardTitle" text="Controle de Compras" class="sapUiSmallMarginTop sapUiSmallMarginBottom" />

    <Panel id="idDashboardFiltrosPanel" headerText="Filtros" class="sapUiSmallMarginBottom">
        <content>
           <HBox id="HBoxFiltros" class="sapUiSmallMargin">
            <VBox id="idReferenceMonthVBox" class="sapUiMediumMarginEnd">
                <Label id="idReferenceMonthText" text="Mês de Referência"></Label>
                <Select 
                    id="idReferenceMonthSelect" 
                    width="12rem"
                    selectedKey="{dashboardData>/filter/period}"
                    items="{dashboardData>/monthOptions}"
                >
                    <core:Item id="idReferenceMonthItem" key="{dashboardData>key}" text="{dashboardData>text}"></core:Item>    
                </Select>
            </VBox>
            
            <Button id="idDshboardIniciarButton" text="Iniciar" press="onIniciarDashboardPress" class="sapUiSmallMarginTop"></Button>
           </HBox>
        </content>
    </Panel>

   <HBox id="idKpiHBox" justifyContent="SpaceBetween" wrap="Wrap" class="sapUiSmallMargin">
            <VBox id="idKpiTotalComprasVBox" width="24%" class="dashboardKpiCard">
                <HBox id="idKpiTotalComprasHBox" alignItems="Center">
                    <core:Icon id="idKpiTotalComprasIcon" src="sap-icon://money-bills" class="dashboardKpiIcon" />
                    <Text id="idKpiTotalComprasLabel" text="Total Geral Compras" class="dashboardKpiLabel" />
                </HBox>
                <Text id="idKpiTotalComprasText" text="{path: 'dashboardData>/kpis/totalBuys', formatter: '.formatCompactCurrency'}" class="dashboardKpiValue" />
            </VBox>
            
            <VBox id="idKpiTotalPedidosVBox" width="24%" class="dashboardKpiCard">
                <HBox id="idKpiTotalPedidosHBox" alignItems="Center">
                    <core:Icon id="idKpiTotalPedidosIcon" src="sap-icon://sales-order" class="dashboardKpiIcon" />
                    <Text id="idKpiTotalPedidosLabel" text="Total Geral Pedidos" class="dashboardKpiLabel" />
                </HBox>
                <Text id="idKpiTotalPedidosText" text="{path: 'dashboardData>/kpis/totalOrders', formatter: '.formatCompactNumber'}" class="dashboardKpiValue" />
            </VBox>
            
            <VBox id="idKpiTotalProdutosVBox" width="24%" class="dashboardKpiCard">
                <HBox id="idKpiTotalProdutosHBox" alignItems="Center">
                    <core:Icon id="idKpiTotalProdutosIcon" src="sap-icon://product" class="dashboardKpiIcon" />
                    <Text id="idKpiTotalProdutosLabel" text="Total Geral Produtos" class="dashboardKpiLabel" />
                </HBox>
                <Text id="idKpiTotalProdutosText" text="{path: 'dashboardData>/kpis/totalProducts', formatter: '.formatCompactNumber'}" class="dashboardKpiValue" />
            </VBox>
            <VBox id="idKpiMediaTempoVBox" width="24%" class="dashboardKpiCard">
                <HBox id="idKpiMediaTempoHBox" alignItems="Center">
                    <core:Icon id="idKpiMediaTempoIcon" src="sap-icon://history" class="dashboardKpiIcon" />
                    <Text id="idKpiMediaTempoLabel" text="Média Tempo Geral Atendimento" class="dashboardKpiLabel" />
                </HBox>
                <Text id="idKpiMediaTempoText" text="{path: 'dashboardData>/kpis/averageLeadTime', formatter: '.formatMinutes'}" class="dashboardKpiValue" />
            </VBox>
        </HBox>

        <HBox id="idDashboardsAndamentoEComparativo" justifyContent="SpaceBetween" wrap="Wrap" class="sapUiSmallMargin">
            <VBox id="idAndamentoPedidosVBox" width="50%">
                <Panel id="idAndamentoDosPedidosPanel" headerText="Andamento dos Pedidos" >
                    <content>
                        <HBox id="idAndamentoPedidosDonutsHBox" justifyContent="SpaceBetween" wrap="Wrap">
                            <VBox id="idDonutEntregaAntecipadaVBox" width="24%" alignItems="Center">
                                <Text id="idDonutEntregaAntecipadaLabel" text="Entrega Antecipada" textAlign="Center" class="dashboardGaugeLabel" />
                                <Text id="idDonutEntregaAntecipadaPercent"  text="{dashboardData>/ordersStatus/earlyPercentage}%" textAlign="Center" class="dashboardGaugePercent" />
                                <VBox id="idDonutEntregaAntecipadaGaugeWrap" class="dashboardGaugeWrap" alignItems="Center">
                                    <microchart:RadialMicroChart
                                        id="idDonutEntregaAntecipadaVizFrame"
                                        percentage="{dashboardData>/ordersStatus/earlyPercentage}"
                                        valueColor="Good"
                                        size="M"
                                    />
                                    <Text id="idDonutEntregaAntecipadaCenterText"  text="{dashboardData>/ordersStatus/early}" class="dashboardGaugeCenterText" />
                                </VBox>
                            </VBox>

                            <VBox id="idDonutEntregaPendenteVBox" width="24%" alignItems="Center">
                                <Text id="idDonutEntregaPendenteLabel" text="Entrega Pendente" textAlign="Center" class="dashboardGaugeLabel" />
                                <Text id="idDonutEntregaPendentePercent" text="{dashboardData>/ordersStatus/pendingPercentage}%" textAlign="Center" class="dashboardGaugePercent" />
                                <VBox id="idDonutEntregaPendenteGaugeWrap" class="dashboardGaugeWrap" alignItems="Center">
                                    <microchart:RadialMicroChart
                                        id="idDonutEntregaPendenteVizFrame"
                                        percentage="{dashboardData>/ordersStatus/pendingPercentage}"
                                        valueColor="Good"
                                        size="M"
                                    />
                                    <Text id="idDonutEntregaPendenteCenterText" text="{dashboardData>/ordersStatus/pending}" class="dashboardGaugeCenterText" />
                                </VBox>
                            </VBox>

                            <VBox id="idDonutEntregaNoPrazoVBox" width="24%" alignItems="Center">
                                <Text id="idDonutEntregaNoPrazoLabel" text="Entrega No Prazo" textAlign="Center" class="dashboardGaugeLabel" />
                                <Text id="idDonutEntregaNoPrazoPercent" text="{dashboardData>/ordersStatus/onTimePercentage}%" textAlign="Center" class="dashboardGaugePercent" />
                                <VBox id="idDonutEntregaNoPrazoGaugeWrap" class="dashboardGaugeWrap" alignItems="Center">
                                    <microchart:RadialMicroChart
                                        id="idDonutEntregaNoPrazoVizFrame"
                                        percentage="{dashboardData>/ordersStatus/onTimePercentage}"
                                        valueColor="Good"
                                        size="M"
                                    />
                                    <Text id="idDonutEntregaNoPrazoCenterText" text="{dashboardData>/ordersStatus/onTime}" class="dashboardGaugeCenterText" />
                                </VBox>
                            </VBox>

                            <VBox id="idDonutEntregaForaPrazoVBox" width="24%" alignItems="Center">
                                <Text id="idDonutEntregaForaPrazoLabel" text="Entrega Fora do Prazo" textAlign="Center" class="dashboardGaugeLabel" />
                                <Text id="idDonutEntregaForaPrazoPercent" text="{dashboardData>/ordersStatus/outTimePercentage}%" textAlign="Center" class="dashboardGaugePercent" />
                                <VBox id="idDonutEntregaForaPrazoGaugeWrap" class="dashboardGaugeWrap" alignItems="Center">
                                    <microchart:RadialMicroChart
                                        id="idDonutEntregaForaPrazoVizFrame"
                                        percentage="{dashboardData>/ordersStatus/outTimePercentage}"
                                        valueColor="Good"
                                        size="M"
                                    />
                                    <Text id="idDonutEntregaForaPrazoCenterText" text="{dashboardData>/ordersStatus/outTime}" class="dashboardGaugeCenterText" />
                                </VBox>
                            </VBox>
                        </HBox>
                    </content>
                </Panel>
            </VBox>

            <VBox id="idComparativoDoisProdutosVBox" width="48%">
                <Panel id="idComparativoDoisProdutosPanel" headerText="Comparativo 2 Produtos" ></Panel>
            </VBox>
        </HBox>

        <HBox id="idDashboardsTotalPedidoEStatus" justifyContent="SpaceBetween" wrap="Wrap" class="sapUiSmallMargin">
            
            <VBox id="idTotalPedidoStatusVBox" width="48%">
                <Panel id="idDashboardTotalPedidos" headerText="Total Pedido x Status">
                    <content>

                    </content>
                </Panel>
            </VBox>

            <VBox id="idStatusTipoDespesa" width="48%">
                <Panel id="idDashboardStatusTipoDespesa" headerText="Status por tipo de despesa">
                    <content>

                    </content>
                </Panel>
            </VBox>

        </HBox>

    
</VBox>

</core:FragmentDefinition>