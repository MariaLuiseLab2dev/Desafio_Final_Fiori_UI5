<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <VBox id="idDetalhesFragmentVBox">
        <Breadcrumbs 
            id="idDetalhesBreadcrumbs"
            currentLocationText="Detalhes"
        >
            <Link id="idPortalDeConsultaDeSaldoDeRCsLink" text="Portal de consulta de saldo de RCs" press=".onBackToListPress" />
        </Breadcrumbs>

        <Title id="idDetalhesTitle" text="Detalhes" class="sapUiSmallMarginTop sapUiSmallMarginBottom" />

        <Panel id="idHistoricoPanel" headerText="Histórico" class="sapUiSmallMarginBottom">
    <content>
        <HBox id="idHistoricoHBox" wrap="Wrap" items="{oHistorico>/}">
            <VBox  id="idHistoricoVBox" class="sapUiSmallMarginEnd" alignItems="Center">
                <core:Icon
                    id="idHistoricoIcon"
                    src="{= ${oHistorico>status} === 'done' ? 'sap-icon://sys-enter-2' : 'sap-icon://circle-task-2' }"
                    color="{= ${oHistorico>status} === 'done' ? 'Positive' : 'Neutral' }" />
                <Text id="idHistoricoText" text="{oHistorico>texto}" textAlign="Center" width="8rem" />
                <Text id="idHistoricoData" text="{oHistorico>data}" textAlign="Center" />
            </VBox>
        </HBox>
    </content>
</Panel>

        <!-- Dados da RC -->
        <Panel id="idDetalhesDadosPanel" headerText="Dados da RC" class="sapUiSmallMarginBottom">
            <content>
                <HBox id="idDetalhesDataRowHBox" wrap="Wrap">
                    <VBox id="idDetalhesReqVBox" class="sapUiMediumMarginEnd">
                        <Label id="idNDaRequisioLabel" text="Nº da Requisição:" />
                        <Text id="idRequestDetailsText" text="{oDetails>/request}" />
                    </VBox>
                    <VBox id="idDetalhesClassVBox" class="sapUiMediumMarginEnd">
                        <Label id="idClassificaoContbilLabel" text="Classificação Contábil:" />
                        <Text id="idDescriptionText" text="{oDetails>/classification/description}" />
                    </VBox>
                    <VBox id="idDetalhesGroupVBox" class="sapUiMediumMarginEnd">
                        <Label id="idGrupoCompradorLabel" text="Grupo Comprador:" />
                        <Text id="idDescriptionBuyerDetailsText" text="{oDetails>/group/description}" />
                    </VBox>
                    <VBox id="idDetalhesMaterialVBox" class="sapUiMediumMarginEnd">
                        <Label id="idMaterialLabel" text="Material:" />
                        <Text id="idDescriptionDetailsText" text="{oDetails>/material/description}" />
                    </VBox>
                    <VBox id="idDetalhesQtyVBox" class="sapUiMediumMarginEnd">
                        <Label id="idQuantidadeLabel" text="Quantidade:" />
                        <Text id="idQuantityDetailsText" text="{oDetails>/quantity}" />
                    </VBox>
                    <VBox id="idDetalhesValueVBox" class="sapUiMediumMarginEnd">
                        <Label id="idValorLabel" text="Valor:" />
                        <Text id="idValueDetailsText" text="{path: 'oDetails>/value', formatter: '.formatCurrency'}" />
                    </VBox>
                    <VBox id="idDetalhesStatusVBox">
                        <Label id="idStatusLabel" text="Status:" />
                        <ObjectStatus id="idStatusObjectStatus" text="{path: 'oDetails>/status', formatter: '.statusText'}" state="Information" />
                    </VBox>
                </HBox>
            </content>
        </Panel>

      <Panel id="idLogPanel">
    <content>
        <Table id="idLogTable" items="{oLog>/}">
            <headerToolbar>
                <Toolbar id="idLogToolbar">
                    <Title id="idLogTitle" text="Log de Transporte (5)" level="H3" />
                    <ToolbarSpacer id="idLogToolbarSpacer" />
                    <SearchField id="idLogSearchField" width="20rem" search=".onLogSearch" />
                </Toolbar>
            </headerToolbar>
            <columns>
                <Column id="idLogDataColumn"><Text id="idLogDataColumnText" text="Data status" /></Column>
                <Column id="idLogStatusColumn"><Text id="idLogStatusColumnText" text="Status" /></Column>
            </columns>
            <items>
                <ColumnListItem id="idLogColumnListItem">
                    <cells>
                        <Text id="idLogDataText" text="{oLog>dataStatus}" />
                        <Text id="idLogStatusText" text="{oLog>status}" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </content>
</Panel>
       
    </VBox>
</core:FragmentDefinition>