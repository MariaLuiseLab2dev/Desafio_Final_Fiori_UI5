<mvc:View
    controllerName="finalprojectui5.controller.ViewAtvos"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Page
        id="idRequisitionsPage"
        title="{i18n>title}"
    >
        <IconTabBar
            id="idMainIconTabBar"
            expandable="false"
            selectedKey="{/selectedTab}"
            xmlns:core="sap.ui.core"
        >
            <items>
                <!-- Aba Portal de consulta -->
                <IconTabFilter
                    id="idPortalDeConsultaIconTabFilter"
                    key="PORTAL"
                    text="Portal de Consulta"
                >
                    <content>
                        <core:Fragment fragmentName="finalprojectui5.view.fragments.Portal" type="XML" />
                    </content>
                </IconTabFilter>

                <!-- Aba Dashboard -->
                <IconTabFilter
                    id="idDashboardIconTabFilter"
                    key="DASHBOARD"
                    text="Dashboard"
                >
                    <content>
                        <core:Fragment fragmentName="finalprojectui5.view.fragments.Dashboard" type="XML" />
                    </content>
                </IconTabFilter>
            </items>
        </IconTabBar>
    </Page>
</mvc:View>
