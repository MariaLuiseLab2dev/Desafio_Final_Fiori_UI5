<mvc:View
    controllerName="finalprojectui5.controller.ViewAtvos"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Page
        id="idRequisitionsPage"
        title="{i18n>title}"
    >
        <IconTabBar
            id="idMainIconTabBar"
            expandable="false"
            selectedKey="{/selectedTab}"
            
            xmlns:core="sap.ui.core"
        >
            <items>
                <!-- Aba Portal de consulta -->
                <IconTabFilter
                    id="idPortalDeConsultaIconTabFilter"
                    key="PORTAL"
                    text="Portal de Consulta"
                >
                    <content>
                        <core:Fragment fragmentName="finalprojectui5.view.fragments.Portal" type="XML" />
                    </content>
                </IconTabFilter>

                <!-- Aba Dashboard -->
                <IconTabFilter
                    id="idDashboardIconTabFilter"
                    key="DASHBOARD"
                    text="Dashboard"
                >
                    <content>
                        <Panel
                            id="idDashboardPanel"
                            headerText="Dashboard"
                            class="sapUiSmallMargin"
                        >
                            <VBox
                                id="idDashboardVBox"
                                renderType="Bare"
                                width="100%"
                            >
                                <HBox
                                    id="idMetricsHBox"
                                    justifyContent="SpaceBetween"
                                    wrap="Wrap"
                                >
                                    <VBox
                                        id="idMetrics1VBox"
                                        width="32%"
                                    >
                                        <Panel
                                            id="idTotalRequisicoesPanel"
                                            headerText="Total Requisições"
                                            class="sapUiSmallMargin"
                                        >
                                            <Text
                                                id="idTotalRequisicoesText"
                                                text="{/metrics/totalRequisicoes}"
                                            />
                                        </Panel>
                                    </VBox>

                                    <VBox
                                        id="idMetricsVBox"
                                        width="32%"
                                    >
                                        <Panel
                                            id="idMetricPanel"
                                            headerText="Valor Total"
                                            class="sapUiSmallMargin"
                                        >
                                            <Text
                                                id="idValorTotalText"
                                                text="{/metrics/valorTotal}"
                                            />
                                        </Panel>
                                    </VBox>

                                    <VBox
                                        id="idVBox"
                                        width="32%"
                                    >
                                        <Panel
                                            id="idAguardandoPanel"
                                            headerText="Aguardando Aprovação"
                                            class="sapUiSmallMargin"
                                        >
                                            <Text
                                                id="idAguardandoText"
                                                text="{/metrics/aguardando}"
                                            />
                                        </Panel>
                                    </VBox>
                                </HBox>

                                <Panel
                                    id="idChartPanel"
                                    headerText="Gráficos"
                                    class="sapUiSmallMarginTop"
                                >
                                    <VBox
                                        id="idChartVBox"
                                        renderType="Bare"
                                    >
                                        <Text
                                            id="idInserirGrficosText"
                                            text="Inserir gráficos"
                                        />
                                    </VBox>
                                </Panel>
                            </VBox>
                        </Panel>
                    </content>
                </IconTabFilter>
            </items>
        </IconTabBar>
        
    </Page>
</mvc:View>
